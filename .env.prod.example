# Production secrets + overrides for docker-compose.prod.yml.
#
#   cp .env.prod.example .env
#   # then fill in every blank value below — do not commit the real .env
#
# This file is deliberately short: docker-compose.prod.yml loads
# backend/.env.example first (every non-secret tunable — rate limits,
# chunking, search, RAG settings — already documented there with sane
# defaults) and this file second, so only values that must genuinely
# differ in production live here. See README.md § Deployment and
# docs/ARCHITECTURE.md § Production deployment for the full picture.

# --- Mode ---
# Enforces app/core/startup_checks.py's fail-fast checks at boot: rejects
# the default JWT_SECRET_KEY and a wildcard CORS_ORIGINS rather than
# silently running insecurely.
ENVIRONMENT=production
DEBUG=false
# Cookies require HTTPS in production (see docs/ARCHITECTURE.md § Cookie
# storage). Only safe to leave false if you are genuinely serving over
# plain HTTP, which you shouldn't be.
COOKIE_SECURE=true
# Must be your real frontend origin(s), not a wildcard — CORSMiddleware is
# configured with allow_credentials=True, and combined with "*" that would
# let any site read authenticated responses.
CORS_ORIGINS=["https://your-domain.example"]

# --- Secrets — generate real values, never reuse these placeholders ---
# openssl rand -hex 32
JWT_SECRET_KEY=
POSTGRES_USER=rag
POSTGRES_DB=rag
# openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=
QDRANT_API_KEY=

# --- LLM / embedding providers ---
# EMBEDDING_PROVIDER=local and CHAT_PROVIDER=ollama are the defaults (set in
# backend/.env.example) — both run fully self-contained, no key needed. Only
# fill in OPENAI_API_KEY if you've switched either provider to "openai"
# below; it's not required otherwise.
# EMBEDDING_PROVIDER=openai
# CHAT_PROVIDER=openai
OPENAI_API_KEY=
# Which model docker-compose.prod.yml's ollama-init service pulls on first
# deploy — must match backend/.env.example's OLLAMA_CHAT_MODEL (or override
# both if you change it). Larger models need more of the ollama service's
# resource limits (docker-compose.prod.yml) than the 4GB default allows.
# OLLAMA_CHAT_MODEL=llama3.2:3b

# --- Frontend build-time config ---
# Baked into the client JS bundle when the frontend image is built (Next.js
# NEXT_PUBLIC_* vars are not runtime-configurable) — the URL a browser will
# actually use to reach the backend, e.g. https://api.your-domain.example
# or http://<your-vm-ip>:8000 if not using a reverse proxy/domain yet.
NEXT_PUBLIC_API_URL=
