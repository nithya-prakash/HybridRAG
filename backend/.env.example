# --- App ---
APP_NAME=rag-knowledge-assistant
# local|test|staging|production — anything other than local/test enforces
# app/core/startup_checks.py's fail-fast checks at boot (rejects the default
# JWT_SECRET_KEY below and a wildcard CORS_ORIGINS). See
# .env.prod.example (repo root) for the settings a real deployment needs changed.
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
REQUEST_ID_HEADER=X-Request-ID

# --- Postgres ---
# POSTGRES_USER/PASSWORD/DB are consumed by the postgres *container* itself
# (see infra/docker-compose.yml) to initialize the database; the app process
# only ever reads POSTGRES_URL. Keep the three in sync with the URL's
# user:password@.../dbname if you change either.
POSTGRES_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
# Must match the output dimensionality of whichever embedding model is
# actually active (EMBEDDING_PROVIDER below) — 384 for the default local
# model (bge-small-en-v1.5), 3072 for OPENAI_EMBEDDING_MODEL's default
# (text-embedding-3-large). Change this together with EMBEDDING_PROVIDER,
# never independently — a mismatch fails loudly on the first Qdrant write,
# not silently.
QDRANT_VECTOR_SIZE=384

# --- Embeddings ---
# local (default): a sentence-transformers model runs in-process, no API key
# or network dependency needed — see app/core/embeddings.py::LocalEmbeddingBackend.
# openai: uses the OpenAI embeddings API instead (needs OPENAI_API_KEY below).
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_RETRIES=5

# --- Chat / generation ---
# ollama (default): talks to a local Ollama server (infra/docker-compose.yml's
# `ollama` service) — no API key, fully self-contained. openai: uses the
# OpenAI chat completions API instead (needs OPENAI_API_KEY below).
CHAT_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.2:3b

# --- OpenAI ---
# Only needed if EMBEDDING_PROVIDER=openai and/or CHAT_PROVIDER=openai above.
OPENAI_API_KEY=sk-changeme
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Auth (JWT) ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Auth (cookies + rate limiting) ---
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT=5/minute
# Per-user (see app/core/rate_limit.py) limits on endpoints that hit paid,
# per-call-billed APIs.
UPLOAD_RATE_LIMIT=20/hour
RETRIEVAL_RATE_LIMIT=30/minute
CHAT_RATE_LIMIT=20/minute

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=/data/uploads

# --- Chunking ---
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=75

# --- Reranker ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Search ---
HYBRID_SEARCH_RRF_K=60
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5

# --- RAG / conversational layer ---
# How many prior turns are included when rewriting a follow-up query and
# generating an answer.
RAG_HISTORY_MAX_TURNS=10
# Below this cross-encoder rerank score, the assistant declines instead of
# guessing. Calibrated against eval/ (see eval/RESULTS.md and this field's
# comment in app/core/config.py) — don't reset this to 0.0, that default was
# shown to reject at least one genuinely correct answer.
RAG_MIN_RERANK_SCORE=-3.0
RAG_MAX_COMPLETION_TOKENS=800
